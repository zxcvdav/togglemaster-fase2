# Banco de dados PostgreSQL
# Formato: postgres://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgres://auth_user:auth_password@localhost:5432/auth_db

# Porta que o serviço irá rodar
PORT=8001

# Chave mestra para criar e gerenciar chaves de API
# ⚠️  Altere isso em produção
MASTER_KEY=admin-secreto-123
